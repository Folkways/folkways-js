# Copy this file to .env and fill it in from your segment in the Folkways dashboard.
# .env is ignored by git: it holds your signing key, so never commit it.

# The node URL, from the segment's Connect tab, e.g. https://realtime.example.com
FOLKWAYS_URL=

# Only for a node that serves WebSocket on its own port, such as a local one:
# FOLKWAYS_WS_URL=ws://127.0.0.1:9005/v1/ws

# The segment ID (a UUID), from the segment's Connect tab
FOLKWAYS_SEGMENT_ID=

# The signing key's ID (kid), from the segment's Signing keys tab
FOLKWAYS_KEY_ID=

# The signing key's private key (Ed25519 or P-256). Set exactly one of these two:
#
# 1. FOLKWAYS_PRIVATE_KEY_FILE: the PATH of the key file, absolute or relative to this folder.
#    Use it when the key is a file: on your laptop, a VM, or a secret mounted as a file.
#    Save the key the dashboard showed you in secrets/, which git ignores.
FOLKWAYS_PRIVATE_KEY_FILE=./secrets/signing-key.pem
#
# 2. FOLKWAYS_PRIVATE_KEY: the KEY ITSELF. Use it when your host injects secrets as environment
#    variables. Keep its newlines, or write them as \n to fit it on one line.
# FOLKWAYS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# Both take the PEM the dashboard gave you, an EC PRIVATE KEY PEM, the PEM's body without its
# -----BEGIN lines, or a private JWK. Only asymmetric signing keys are supported.

# Optional: how long each token lives, in seconds (60 to 900). Default 600.
# FOLKWAYS_TOKEN_TTL_SECONDS=600

# Optional: signs the example's sign-in sessions. When unset, a random one is made at
# startup, so everyone is signed out when the server restarts (with pnpm dev, that is
# every SDK rebuild). Make one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# SESSION_SECRET=

# Optional: where the server listens. Default 127.0.0.1:8787.
# HOST=127.0.0.1
# PORT=8787
