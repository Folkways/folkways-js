# Copy this file to .env and fill it in from your segment in the Folkways dashboard.
# .env is ignored by git: it holds your signing key, so never commit it.

# The node URL, from the segment's Connect tab, e.g. https://rte.example.com
RTE_URL=

# The segment ID (a UUID), from the segment's Connect tab
RTE_SEGMENT_ID=

# The signing key's ID (kid), from the segment's Signing keys tab
RTE_KEY_ID=

# The signing key's private half. Set exactly one of these three:
#
# 1. A key pair (Ed25519 or P-256): the path of the private key file (PKCS#8 PEM).
#    Save the key the dashboard showed you in secrets/, which git ignores.
RTE_PRIVATE_KEY_FILE=./secrets/signing-key.pem
#
# 2. A key pair, with the PEM itself in the variable (newlines may be written as \n).
#    Handy where secrets are injected as environment variables.
# RTE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# 3. A shared secret (HS256): the secret the dashboard showed you once.
# RTE_SECRET=

# Optional: how long each token lives, in seconds (60 to 900). Default 600.
# RTE_TOKEN_TTL_SECONDS=600

# Optional: signs the example's sign-in cookie. When unset, a random one is made at
# startup, so everyone is signed out when the server restarts.
# SESSION_SECRET=

# Optional: where the server listens. Default 127.0.0.1:8787.
# HOST=127.0.0.1
# PORT=8787
