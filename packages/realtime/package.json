{
  "name": "@folkways/realtime",
  "version": "0.1.0",
  "description": "Client SDK for the Folkways Realtime Transport Engine (RTE v1)",
  "license": "MIT",
  "author": "Folkways",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./stores/indexeddb": {
      "types": "./dist/stores/indexeddb.d.ts",
      "import": "./dist/stores/indexeddb.mjs",
      "require": "./dist/stores/indexeddb.js"
    },
    "./stores/async-storage": {
      "types": "./dist/stores/async-storage.d.ts",
      "import": "./dist/stores/async-storage.mjs",
      "require": "./dist/stores/async-storage.js"
    },
    "./stores/file": {
      "types": "./dist/stores/file.d.ts",
      "import": "./dist/stores/file.mjs",
      "require": "./dist/stores/file.js"
    },
    "./iife": "./dist/index.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config tsup.base.config.ts && tsup --config tsup.iife.config.ts",
    "dev": "tsup --config tsup.base.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "proto": "sh scripts/gen-proto.sh",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "flatbuffers": "24.3.25"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "fake-indexeddb": "6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "keywords": [
    "realtime",
    "websocket",
    "long-poll",
    "pubsub",
    "flatbuffers",
    "folkways",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Folkways/folkways-js.git",
    "directory": "packages/realtime"
  }
}
