{
  "name": "@folkways/realtime",
  "version": "0.1.0",
  "description": "Client SDK for the Folkways Realtime Transport Engine",
  "license": "Apache-2.0",
  "author": "Folkways",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./stores/indexeddb": {
      "import": {
        "types": "./dist/stores/indexeddb.d.mts",
        "default": "./dist/stores/indexeddb.mjs"
      },
      "require": {
        "types": "./dist/stores/indexeddb.d.ts",
        "default": "./dist/stores/indexeddb.js"
      }
    },
    "./stores/async-storage": {
      "import": {
        "types": "./dist/stores/async-storage.d.mts",
        "default": "./dist/stores/async-storage.mjs"
      },
      "require": {
        "types": "./dist/stores/async-storage.d.ts",
        "default": "./dist/stores/async-storage.js"
      }
    },
    "./stores/file": {
      "import": {
        "types": "./dist/stores/file.d.mts",
        "default": "./dist/stores/file.mjs"
      },
      "require": {
        "types": "./dist/stores/file.d.ts",
        "default": "./dist/stores/file.js"
      }
    },
    "./iife": "./dist/index.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config tsup.base.config.ts && tsup --config tsup.iife.config.ts",
    "dev": "tsup --config tsup.base.config.ts --watch --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "proto": "sh scripts/gen-proto.sh",
    "clean": "rm -rf dist",
    "pack:release": "node scripts/pack-release.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "flatbuffers": "24.3.25"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.2",
    "fake-indexeddb": "6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6",
    "ws": "^8.22.0"
  },
  "keywords": [
    "realtime",
    "websocket",
    "long-poll",
    "pubsub",
    "flatbuffers",
    "folkways",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Folkways/folkways-js.git",
    "directory": "packages/realtime"
  }
}
